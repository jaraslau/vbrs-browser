# ---------------------------------------------------------------------------
# vbrs-browser — Docker Compose configuration
#
# This file is read by Docker Compose for variable interpolation only.
# Services never receive it: each service gets its own file through
# `env_file` so it only sees the variables it actually needs.
#
# Per-service configuration lives next to this file:
#
#   .env.backend     -> backend      (application settings)
#   .env.frontend    -> frontend     (nginx runtime settings)
#   .env.elasticsearch -> elasticsearch (container settings)
#
# Each has a matching `.env.<service>.example`. To set up a fresh checkout:
#
#   for f in .env .env.backend .env.frontend .env.elasticsearch; do
#       cp "$f.example" "$f"
#   done
#
# All `.env*` files are gitignored. Never commit real secrets or
# environment-specific values, and never restate a value from this file
# in docker-compose.yml: Compose consumes it through interpolation, and
# values a service needs at runtime are injected by Compose via
# `environment` rather than duplicated in that service's own file.
# ---------------------------------------------------------------------------

# --- Compose wiring --------------------------------------------------------

# Host port published for the frontend (the only service exposed beyond the
# Docker host's loopback interface).
FRONTEND_PORT=8080

# Port the backend listens on inside its container. Compose maps it on
# 127.0.0.1 only and passes the same value to the backend (listen port) and
# to the frontend (nginx proxy target), so this is the single source of
# truth for the backend's port.
BACKEND_PORT=8000

# Host port published for Elasticsearch, bound to 127.0.0.1 for local tooling
# (e.g. `curl localhost:9200`). Nothing outside this host can reach it.
ES_PUBLIC_PORT=9200

# Host directory containing the dictionary article JSON files. Compose mounts
# it read-only into the backend container at DICTIONARY_IMPORT_DIR.
DICTIONARY_SOURCE_DIR=../slouniki/json/articles

# Directory inside the backend container that the dictionary files are
# mounted at. The container entrypoint imports it before starting the
# server; Compose injects this variable into the backend because it owns
# both sides of the bind mount. Keep it aligned with the mount target.
DICTIONARY_IMPORT_DIR=/data/dictionary
