# ---------------------------------------------------------------------------
# vbrs-browser environment configuration
#
# This file is the single source of truth for environment-variable values.
# Copy it to `.env` and adjust as needed:
#
#     cp .env.example .env
#
# `.env` is gitignored. Do not commit real secrets or environment-specific
# values, and do not restate any value below in Docker Compose configuration:
# Compose consumes this file instead.
#
# Values marked [compose] are used only by docker-compose.yml for host-side
# wiring (published ports and bind mounts) and are not read by the
# application.
# ---------------------------------------------------------------------------

# --- Application settings (consumed via pydantic-settings) -----------------

# Host/interface the backend binds to inside its container.
BACKEND_HOST=0.0.0.0
# Port the backend listens on inside its container. Docker Compose also uses
# this to map the published host port.
BACKEND_PORT=8000
# URL prefix every API route is mounted under. Must start with "/" and must
# not end with "/".
API_V1_PREFIX=/api/v1

# JSON list of allowed CORS origins for the backend (pydantic-settings parses
# complex values as JSON).
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# URL of the Elasticsearch cluster. docker-compose overrides this with the
# in-network service address because the .env value above addresses the
# published port on the Docker host.
ES_URL=http://localhost:9200
# Name of the index used to store dictionary articles.
ES_INDEX=dictionary
# Connection and request timeouts in seconds.
ES_CONNECT_TIMEOUT=5
ES_REQUEST_TIMEOUT=30
# Snapshot retention between requests while resolving a deep page; closed after use.
ES_PIT_KEEP_ALIVE_SECONDS=60

# Default page size used when a request does not specify one.
PAGE_SIZE=20
# Maximum page size accepted by the API.
MAX_PAGE_SIZE=100

# Number of documents sent to Elasticsearch in a single bulk request.
INGESTION_BATCH_SIZE=1000

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Container entrypoint --------------------------------------------------

# Directory inside the backend container that the dictionary article JSON
# files are mounted at. When set, the entrypoint imports that directory
# before starting the server; when unset or empty, no import is attempted.
# Keep this aligned with the bind-mount target in docker-compose.yml.
DICTIONARY_IMPORT_DIR=/data/dictionary

# --- Compose wiring --------------------------------------------------------

# Host port mapped to the frontend container. The container itself listens on
# its unprivileged port (see vbrs-browser/frontend/nginx.conf.template).
FRONTEND_PORT=8080
# Host port mapped to the Elasticsearch container.
ES_PUBLIC_PORT=9200
# Backend upstream that nginx proxies /api to, as seen from inside the
# Compose network.
BACKEND_INTERNAL_URL=http://backend:8000
# Host directory containing the dictionary article JSON files. Compose mounts
# it read-only at DICTIONARY_IMPORT_DIR.
DICTIONARY_SOURCE_DIR=../slouniki/json/articles

# Elasticsearch container settings. The defaults below suit a single-node
# development cluster; a production deployment should override the discovery
# mode and enable security.
ES_DISCOVERY_TYPE=single-node
ES_SECURITY_ENABLED=false
ES_JAVA_OPTS=-Xms512m -Xmx512m
