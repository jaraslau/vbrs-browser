# ---------------------------------------------------------------------------
# vbrs-browser environment configuration
#
# Copy this file to `.env` and adjust values as needed:
#
#     cp .env.example .env
#
# Do not commit real secrets or environment-specific values.
# ---------------------------------------------------------------------------

# Host/interface the backend binds to inside its container.
BACKEND_HOST=0.0.0.0
# Port the backend listens on inside its container.
BACKEND_PORT=8000
# Publicly reachable backend URL (used for CORS / documentation).
BACKEND_PUBLIC_URL=http://localhost:8000
# Publicly reachable frontend URL.
FRONTEND_PUBLIC_URL=http://localhost:8080
# Host port mapped to the frontend container (used by docker-compose).
FRONTEND_PORT=8080

# JSON list of allowed CORS origins for the backend (pydantic-settings parses
# complex values as JSON).
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# URL of the Elasticsearch cluster. Inside docker-compose the backend
# overrides this with http://elasticsearch:9200.
ES_URL=http://localhost:9200
# Name of the index used to store dictionary articles.
ES_INDEX=dictionary
# Connection and request timeouts in seconds.
ES_CONNECT_TIMEOUT=5
ES_REQUEST_TIMEOUT=30

# Default page size used when a request does not specify one.
PAGE_SIZE=20
# Maximum page size accepted by the API.
MAX_PAGE_SIZE=100

# Number of documents sent to Elasticsearch in a single bulk request.
INGESTION_BATCH_SIZE=1000

# Host directory containing the dictionary article JSON files. Docker Compose
# mounts it read-only and imports it before starting the backend.
DICTIONARY_SOURCE_DIR=../slouniki/json/articles

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
