# ---------------------------------------------------------------------------
# Frontend (nginx) runtime configuration.
#
# Copy to `.env.frontend` and adjust as needed:
#
#     cp .env.frontend.example .env.frontend
#
# In Docker Compose this file is attached to the frontend service only
# (`env_file` in docker-compose.yml); no other service sees these values.
# Compose additionally injects BACKEND_PORT from the repository `.env` file
# so the proxy target port always matches the backend's published port.
#
# `.env.frontend` is gitignored.
# ---------------------------------------------------------------------------

# Hostname of the backend that nginx proxies /api/ requests to. On the
# Docker Compose network this is the backend service name; it must resolve
# from inside the frontend container. The port is appended from
# BACKEND_PORT (injected by Compose), so only the host belongs here.
BACKEND_UPSTREAM_HOST=backend

# Shared budgets across API clients; keep static asset delivery unrestricted.
API_RATE_LIMIT=30r/s
API_RATE_BURST=60
API_MAX_CONCURRENT=10
