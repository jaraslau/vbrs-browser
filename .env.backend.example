# ---------------------------------------------------------------------------
# Backend service configuration (consumed via pydantic-settings).
#
# Copy to `.env.backend` and adjust as needed:
#
#     cp .env.backend.example .env.backend
#
# In Docker Compose this file is attached to the backend service only
# (`env_file` in docker-compose.yml); no other service sees these values.
# Compose additionally injects the deployment wiring from the repository
# `.env` file — BACKEND_PORT and DICTIONARY_IMPORT_DIR — which is therefore
# intentionally absent here. Outside Compose the backend falls back to its
# built-in defaults for those (port 8000, no dictionary import).
#
# `.env.backend` is gitignored. Do not commit real secrets or
# environment-specific values.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------

# Host/interface the backend binds to inside its container.
BACKEND_HOST=0.0.0.0
# URL prefix every API route is mounted under. Must start with "/" and must
# not end with "/".
API_V1_PREFIX=/api/v1

# JSON list of allowed CORS origins for the backend (pydantic-settings parses
# complex values as JSON). Not required when the frontend proxies /api
# same-origin, but kept for running the frontend dev server against it.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Elasticsearch ---------------------------------------------------------

# URL of the Elasticsearch cluster as reachable from where the backend runs:
# the host-published port for local development, the in-network service
# address under Docker Compose (Compose overrides this with
# http://elasticsearch:9200).
ES_URL=http://localhost:9200
# Name of the index used to store dictionary articles.
ES_INDEX=dictionary
# Connection and request timeouts in seconds.
ES_CONNECT_TIMEOUT=5
ES_REQUEST_TIMEOUT=30
# Snapshot retention between requests while resolving a deep page; closed after use.
ES_PIT_KEEP_ALIVE_SECONDS=60

# --- API behavior ----------------------------------------------------------

# Default page size used when a request does not specify one.
PAGE_SIZE=20
# Maximum page size accepted by the API.
MAX_PAGE_SIZE=100

# Number of documents sent to Elasticsearch in a single bulk request.
INGESTION_BATCH_SIZE=1000

# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
