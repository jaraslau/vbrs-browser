# ---------------------------------------------------------------------------
# Elasticsearch container configuration.
#
# Copy to `.env.elasticsearch` and adjust as needed:
#
#     cp .env.elasticsearch.example .env.elasticsearch
#
# In Docker Compose this file is attached to the elasticsearch service only
# (`env_file` in docker-compose.yml). These are the variables the
# Elasticsearch image itself reads; they are not application settings and no
# other service needs them.
#
# `.env.elasticsearch` is gitignored.
# ---------------------------------------------------------------------------

# Cluster topology: single-node for development, or leave unset / use
# "multi-node" style configuration for a production cluster.
discovery.type=single-node

# --- TLS and authentication -------------------------------------------------
# Certificates are generated once into the `es_certs` volume by the
# es-certs-init service (unprivileged, idempotent) and the node runs with
# explicit TLS settings. Enabling security here switches the node to manual
# configuration mode, which deliberately skips the image's first-boot
# auto-configuration (it cannot generate certificates onto a mounted volume).

# Enable security and TLS on the HTTP and transport layers.
xpack.security.enabled=true
xpack.security.http.ssl.enabled=true
xpack.security.http.ssl.key=certs/es01/es01.key
xpack.security.http.ssl.certificate=certs/es01/es01.crt
xpack.security.http.ssl.certificate_authorities=certs/ca/ca.crt
xpack.security.transport.ssl.enabled=true
xpack.security.transport.ssl.verification_mode=certificate
xpack.security.transport.ssl.key=certs/es01/es01.key
xpack.security.transport.ssl.certificate=certs/es01/es01.crt
xpack.security.transport.ssl.certificate_authorities=certs/ca/ca.crt

# Superuser account the backend authenticates as, and that local host
# tooling can use (e.g. `curl -k -u elastic:<password> https://localhost:9200`).
# ELASTIC_PASSWORD must be a strong password and must equal ES_PASSWORD in
# `.env.backend`. It is set at cluster bootstrap; changing it here later
# requires `elasticsearch-reset-password`.
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=change-me

# JVM heap for the Elasticsearch process.
ES_JAVA_OPTS=-Xms512m -Xmx512m