# ---------------------------------------------------------------------------
# Elasticsearch container configuration.
#
# Copy to `.env.elasticsearch` and adjust as needed:
#
#     cp .env.elasticsearch.example .env.elasticsearch
#
# In Docker Compose this file is attached to the elasticsearch service only
# (`env_file` in docker-compose.yml). These are the variables the
# Elasticsearch image itself reads; they are not application settings and no
# other service needs them.
#
# The defaults below suit a single-node development cluster; a production
# deployment should override the discovery mode and enable security.
#
# `.env.elasticsearch` is gitignored.
# ---------------------------------------------------------------------------

# Cluster topology: single-node for development, or leave unset / use
# "multi-node" style configuration for a production cluster.
discovery.type=single-node

# Set to true in production so the cluster requires authentication.
xpack.security.enabled=false

# JVM heap for the Elasticsearch process.
ES_JAVA_OPTS=-Xms512m -Xmx512m
