# ---------------------------------------------------------------------------
# Proxy (Caddy) runtime configuration.
#
# Copy to `.env.proxy` and adjust as needed:
#
#     cp .env.proxy.example .env.proxy
#
# In Docker Compose this file is attached to the proxy service only
# (`env_file` in docker-compose.yml); no other service sees these values.
#
# `.env.proxy` is gitignored.
# ---------------------------------------------------------------------------

# Public hostname TLS certificates are issued for and that all traffic is
# served under. Before going live the domain must resolve (A/AAAA records)
# to this host, and ports 80/443 must be reachable, or Let's Encrypt cannot
# issue. `localhost` is the safe pre-DNS default: Caddy serves it with its
# own internal CA so the stack is testable without a public name.
PUBLIC_DOMAIN=localhost