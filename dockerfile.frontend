# syntax=docker/dockerfile:1
#
# Multi-stage build for the vbrs-browser frontend.
#
# Stage 1 builds the static assets with Node/Vite.
# Stage 2 serves the built assets with nginx and proxies /api to the backend.
#
# The runtime image is nginx-unprivileged: it already runs as a dedicated
# unprivileged user, keeps all state under /tmp, and listens on an
# unprivileged port, so no Linux capabilities are required. The published
# port is not baked into the image because Compose owns the host-side
# mapping.

FROM node:22-alpine AS builder

WORKDIR /app

COPY vbrs-browser/frontend/package.json vbrs-browser/frontend/package-lock.json ./
RUN npm ci

COPY vbrs-browser/frontend/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY --from=builder --chown=nginx:nginx /app/dist /usr/share/nginx/html
COPY --chown=nginx:nginx vbrs-browser/frontend/nginx.conf.template /etc/nginx/templates/default.conf.template

USER nginx

CMD ["nginx", "-g", "daemon off;"]