# Frontend environment configuration (used by the Vite dev server).
# Copy to frontend/.env and adjust as needed.

# Target of the Vite dev-server proxy for /api requests.
VITE_BACKEND_URL=http://localhost:8000

# Base URL of the backend API used by the application code.
# Leave empty to use the same origin (nginx proxies /api in production).
VITE_API_BASE_URL=